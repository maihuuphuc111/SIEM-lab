
services:
  # 1. KAFKA (KRaft mode - Không cần Zookeeper)
  kafka: 
    image: apache/kafka:latest
    container_name: siem-kafka
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: 'broker,controller'
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: 'CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT'
      KAFKA_LISTENERS: 'PLAINTEXT://:9092,CONTROLLER://:9093'
      # 👉 ĐỔI 192.168.1.100 THÀNH IP CỦA KALI LINUX/VMWARE CỦA BẠN
      KAFKA_ADVERTISED_LISTENERS: 'PLAINTEXT://192.168.1.117:9092'
      KAFKA_CONTROLLER_QUORUM_VOTERS: '1@localhost:9093'
      KAFKA_CONTROLLER_LISTENER_NAMES: 'CONTROLLER'
      KAFKA_INTER_BROKER_LISTENER_NAME: 'PLAINTEXT'
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
    volumes:
      - kafka_data:/var/lib/kafka/data
  # 2. CLICKHOUSE SERVER
  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: siem-clickhouse
    ports:
      - "8123:8123"   # Cổng HTTP (Python và Grafana dùng cổng này)
      - "9000:9000"   # Cổng Native Client
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    environment:
      - CLICKHOUSE_DB=siem_logs
      - CLICKHOUSE_USER=admin
      - CLICKHOUSE_PASSWORD=admin
      - CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
    volumes:
      - clickhouse_data:/var/lib/clickhouse

  # 3. GRAFANA
  grafana:
    image: grafana/grafana:latest
    container_name: siem-grafana
    ports:
      - "3000:3000"   # Cổng Web UI của Grafana
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana_data:/var/lib/grafana

volumes:
  kafka_data:
  clickhouse_data:
  grafana_data:
